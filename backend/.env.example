# Puerto del servidor backend
PORT=3001

# URL del frontend (para CORS en desarrollo)
# En producción con Plesk, poner el dominio real
FRONTEND_URL=http://localhost:5173

# =============================================================
# CONFIGURACIÓN SQL SERVER - Plesk / Producción
